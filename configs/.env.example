# =============================================================================
# Grader 环境变量示例
#
# 用法：在项目根复制为 .env（cp configs/.env.example .env）后按需修改。
# 首次 import 业务模块（启动服务 / 跑 eval）时，harness/config.py 会自动加载
# 项目根的 .env；它只用 setdefault 填补“缺失”的变量——shell 里已经 export
# 的同名变量优先级更高，不会被 .env 覆盖。也可用 GRADER_ENV_FILE 指定其它路径。
#
# 离线三开关同时置 1，即可不依赖真实 LLM / LMS 跑通主链路与全部 eval。
# =============================================================================

# --- 离线三开关 -------------------------------------------------------------
# =1 禁用所有 LLM：意图路由 / QueryRewrite / 批改草稿全部走规则兜底
# 默认：未设置（在线模式）
GRADER_DISABLE_LLM=1

# =1 RAG embedding 用本地 token 确定性替身（256 维哈希向量）
# 默认：未设置（在线 OpenAI 兼容 embedding）
GRADER_OFFLINE_RAG=1

# =1 LMS 数据允许回退到 configs/seed_data.json 内置种子镜像
# 默认：未设置（不回退，必须连真实 LMS）
GRADER_OFFLINE_FACTS=1

# --- 模型接入 ---------------------------------------------------------------
# 模型 API key；占位串（如 "placeholder" / "sk-xxx"）视为缺失
# 默认：无
GRADER_LLM_API_KEY=placeholder

# OpenAI 兼容模型服务地址
# 默认：https://api.siliconflow.cn/v1
GRADER_LLM_BASE_URL=https://api.siliconflow.cn/v1

# 聊天模型名
# 默认：Qwen/Qwen3-8B
GRADER_LLM_MODEL=Qwen/Qwen3-8B

# Embedding 模型名
# 默认：BAAI/bge-m3
GRADER_EMBEDDING_MODEL=BAAI/bge-m3

# Rerank 模型名（在线重排，POST {GRADER_LLM_BASE_URL}/rerank）
# 默认：BAAI/bge-reranker-v2-m3；离线（GRADER_OFFLINE_RAG=1）不调用，走确定性来源权重
GRADER_RERANK_MODEL=BAAI/bge-reranker-v2-m3

# --- LMS 接入（在线事实来源；离线三开关置 1 时以下两项不生效）----------------
# LMS 只读 API 根地址
# 默认：https://lms.example.com/api
GRADER_LMS_BASE_URL=https://lms.example.com/api

# 委派调用 LMS 的服务令牌（请求头 X-Grader-Service-Token）
# 默认：dev-token
GRADER_LMS_SERVICE_TOKEN=dev-token

# --- 运行时 -----------------------------------------------------------------
# 自定义 .env 路径（只能在 shell 里给定，例如 export GRADER_ENV_FILE=/path/x.env），
# 因为它决定 .env 自身的位置；不设置时从当前工作目录向上查找第一个 .env。
# GRADER_ENV_FILE=
